# These environment variables are also passed to Authelia's configuration.yml
WEB_URL=my.url.com
WEB_URL_DOMAIN=url.com
WEB_URL_IMMICH=immich.url.com
WEB_URL_CALIBRE=calibre.url.com
WEB_URL_AI=ai.url.com
# Configuration directory
SERVICE_DIR_AUTHELIA=/your/services/path/authelia
# GENERATE with (and escape every $ with a double $$ so that Portainer loads it properly!):
# sudo docker run --rm authelia/authelia:latest authelia crypto hash generate pbkdf2 --password 'YOUR_APP_SECRET'
SECRET_IMMICH=$$pbkd...Yv7fq9g$$8oOA...
SECRET_CALIBRE=$$pbk...10000$$l.W1RZ/sM...
SECRET_AI=$$pbk.....-sha512$$....
# Injected variables (starting with AUTHELIA_*)
AUTHELIA_TOTP_ISSUER=Your Server
# GENERATE SMTP token in the Google account, security, app passwords
AUTHELIA_NOTIFIER_SMTP_ADDRESS=submissions://smtp.gmail.com:465
AUTHELIA_NOTIFIER_SMTP_USERNAME=my.server@gmail.com
AUTHELIA_NOTIFIER_SMTP_PASSWORD=dwb...jpdb
AUTHELIA_NOTIFIER_SMTP_SENDER=Server OAuth <my.server@gmail.com>
# GENERATE these session secrets with:
# openssl rand -hex 64
# To reset these we have to remove the database, which will reset all user passwords:
# sudo rm /mnt/hot/services/authelia/db.sqlite3 /mnt/hot/services/authelia/notification.txt
AUTHELIA_SESSION_SECRET=326a269894350...
AUTHELIA_STORAGE_ENCRYPTION_KEY=fc3a294a...
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=3ac7039dcf...
